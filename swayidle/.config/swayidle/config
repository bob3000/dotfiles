timeout 30 'pgrep -x swaylock && [ "$(brightnessctl g)" -gt 0 ] && brightnessctl -s set 0%' resume '[ "$(brightnessctl g)" -eq 0 ] && brightnessctl -r'
timeout 300 'pgrep -x swaylock || swaylock -f; [ "$(brightnessctl g)" -gt 0 ] && brightnessctl -s set 0%' resume '[ "$(brightnessctl g)" -eq 0 ] && brightnessctl -r'
before-sleep 'pgrep -x swaylock || swaylock -f'
